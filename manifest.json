{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.1.0",
  "icons": {
    "16": "branding/icon-16.png",
    "32": "branding/icon-32.png",
    "48": "branding/icon-48.png",
    "128": "branding/icon-128.png"
  },
  "minimum_chrome_version": "138",
  "description": "Control browser tabs with natural language prompts via Gemini Nano",
  "permissions": ["tabs", "sidePanel", "scripting", "tabGroups", "activeTab", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "src/background/worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open TabPilot",
    "default_icon": {
      "16": "branding/icon-16.png",
      "32": "branding/icon-32.png",
      "48": "branding/icon-48.png"
    }
  }
}
