{
  "name": "tabpilot",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.mjs",
    "postinstall": "node ./scripts/ensure-rolldown-binding.mjs",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "build": "npm run typecheck && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "repro": "node ./node_modules/@playwright/test/cli.js test tests/e2e/task-repro.spec.ts",
    "test:gp": "node ./node_modules/@playwright/test/cli.js test tests/e2e/youtube-gp.spec.ts"
  },
  "dependencies": {
    "puppeteer": "^25.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.6.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
